# ==============================================================================
#  Omada API Assistant — configuración
#  1) Copia este archivo:   cp .env_template .env     (Windows: copy .env_template .env)
#  2) Pon tu API key de OpenAI.
#  3) Nunca subas el archivo .env a GitHub (ya está en .gitignore).
# ==============================================================================

# ---- OpenAI (obligatorio) -----------------------------------------------------
OPENAI_API_KEY=sk-...

# Modelo que responde en el chat. Cualquier modelo de la Responses API con soporte
# de herramientas (function calling). Comprueba cuáles tiene tu cuenta.
# gpt-4o-mini: muy económico (recomendado para empezar). Si falla en consultas de varios
# pasos, prueba un modelo intermedio o uno de razonamiento (y entonces usa REASONING_EFFORT).
OPENAI_MODEL=gpt-4o-mini

# Modelo de embeddings para el RAG. Si lo cambias, reconstruye el índice:
#   python manage.py build-index --full
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Opcionales de OpenAI (vacío = valor por defecto del modelo) ----------------
# Solo para modelos de razonamiento: minimal | low | medium | high.
# Déjalo VACÍO con modelos que no razonan (ej. gpt-4.1) o la API dará error.
OPENAI_REASONING_EFFORT=
# Solo para modelos que lo admiten (los de razonamiento NO lo admiten).
OPENAI_TEMPERATURE=0.2
# Tope de tokens de salida por respuesta (en modelos de razonamiento incluye el razonamiento).
OPENAI_MAX_OUTPUT_TOKENS=
# Dimensiones del embedding (solo familia text-embedding-3). Vacío = por defecto.
OPENAI_EMBEDDING_DIMENSIONS=
# Para Azure OpenAI o un proxy compatible. Vacío = api.openai.com
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3

# ---- Base de conocimiento (RAG) ---------------------------------------------------
# Archivo .json/.zip de la especificación, o la carpeta que lo contiene.
SPEC_PATH=data/spec
# Carpeta con guías en Markdown/texto (autenticación, tablas, etc.).
GUIDES_DIR=data/guides
# Dónde se guarda el índice generado.
INDEX_DIR=data/index
# Resultados por búsqueda y candidatos que se fusionan.
RAG_TOP_K=8
RAG_CANDIDATES=40
# Añade a la búsqueda las palabras de la propia API ("reiniciar" -> reboot, "parpadear" -> locate).
RAG_QUERY_EXPANSION=true

# ---- Agente -------------------------------------------------------------------------
# Máximo de rondas de consulta al RAG por respuesta.
AGENT_MAX_TOOL_ROUNDS=6
# Si la pregunta toca autenticación, cabeceras, límites o tablas de valores, el asistente lee la guía
# por su cuenta antes de responder (evita que un modelo pequeño conteste de memoria). true | false
AGENT_GUIDE_PREFETCH=true
# Mensajes de historial enviados al modelo y tamaño máximo por mensaje.
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=8000

# ---- Evaluaciones (python manage.py eval) -----------------------------------------
# Modelo que califica las respuestas. Vacío = el mismo OPENAI_MODEL, pero un juez pequeño califica mal
# (suele marcar como error respuestas correctas): para medir en serio usa uno más capaz que OPENAI_MODEL.
OPENAI_JUDGE_MODEL=
# Preguntas que se responden en paralelo y operaciones muestreadas para evaluar la búsqueda.
EVAL_CONCURRENCY=3
EVAL_RETRIEVAL_SAMPLES=300
# Precios por millón de tokens para estimar el costo (vacío = precios de referencia conocidos).
EVAL_PRICE_INPUT_PER_MTOK=
EVAL_PRICE_OUTPUT_PER_MTOK=

# ---- Servidor web -------------------------------------------------------------------
# 127.0.0.1 = solo tu equipo. 0.0.0.0 = visible en tu red (usa PORTAL_ACCESS_TOKEN).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Si defines un token, el navegador lo pedirá una vez.
PORTAL_ACCESS_TOKEN=
# Peticiones de chat por minuto y por IP (0 = sin límite).
RATE_LIMIT_PER_MINUTE=20
# Orígenes CORS permitidos, separados por comas. Vacío = desactivado.
CORS_ORIGINS=

# ---- Quién pregunta (para límites y registro de uso) ----------------------------------
# Detrás de un proxy con login (Cloudflare Access, oauth2-proxy...), nombre de la cabecera que trae el
# correo del usuario, p. ej. X-Forwarded-Email. SOLO actívalo si el proxy la pone y borra la que envíe
# el cliente; si no, cualquiera podría suplantar a otro. Vacío = se distingue a las personas por IP.
PORTAL_USER_HEADER=
# true si hay un proxy delante: la IP real se lee de X-Forwarded-For.
PORTAL_BEHIND_PROXY=false
# Correos (separados por comas) que pueden ver el uso de TODOS. Vacío = cualquier usuario autenticado.
PORTAL_ADMINS=

# ---- Límites de gasto (0 = sin límite) ----------------------------------------------
# Se comprueban ANTES de cada pregunta. Una respuesta puede pasarse del tope por su propio costo (centavos).
# Todos juntos, por día y por mes (en dólares):
BUDGET_DAILY_USD=5
BUDGET_MONTHLY_USD=50
# Cada persona, por día (en dólares) y número de preguntas por día. Este último funciona aunque no
# se conozca el precio del modelo.
BUDGET_USER_DAILY_USD=1
USER_DAILY_REQUESTS=200
# Zona horaria que define cuándo empieza el día (p. ej. America/Guayaquil). Por defecto UTC.
USAGE_TIMEZONE=UTC
# Dónde se guarda el registro de uso (SQLite). No contiene el texto de las preguntas.
USAGE_DB_PATH=data/usage/usage.db
# Precio por millón de tokens, solo si tu modelo no está en la lista conocida o el precio cambió.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# ---- Logs ----------------------------------------------------------------------------
# console = legible en la terminal · json = una línea JSON por evento (para servidores y recolectores de logs).
LOG_FORMAT=console
# Archivo con rotación (10 MB x 5), en JSON. Vacío = solo pantalla.
LOG_FILE=
# false = nunca se escribe el texto de las preguntas en los logs (solo su tamaño). Actívalo solo para depurar.
LOG_QUESTIONS=false
